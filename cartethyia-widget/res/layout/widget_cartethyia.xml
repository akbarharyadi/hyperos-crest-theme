<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/marcellus"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#CC050A1C"
            android:shadowRadius="8"
            android:textColor="#F0F7FF"
            android:textSize="58sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/marcellus"
            android:format12Hour="EEEE, d MMM"
            android:format24Hour="EEEE, d MMM"
            android:shadowColor="#CC050A1C"
            android:shadowRadius="6"
            android:textColor="#D8B26A"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/marcellus"
            android:letterSpacing="0.12"
            android:text="@string/caption"
            android:textColor="#78CDFF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
