<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.wuwafan.cartethyia"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <!-- needed to resolve the game's launch intent on Android 11+ -->
    <queries>
        <package android:name="com.kurogame.wutheringwaves.global" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/app_icon"
        android:allowBackup="false">

        <receiver
            android:name=".CartethyiaWidget"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cartethyia_widget_info" />
        </receiver>

        <!-- no launcher icon: started with `adb shell am start -n dev.wuwafan.cartethyia/.PinActivity` -->
        <activity
            android:name=".PinActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
